# ─────────────────────────────────────────────────────────────────────────────
# SmartBank AI — Environment Variables
# Copy to .env and fill in values. Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Environment
ENVIRONMENT=development   # development | staging | production

# Security — MUST be changed in production
SERVICE_AUTH_TOKEN=dev-secret-change-in-production-minimum-32-chars
ORCHESTRATOR_ALLOWED_CLIENT_ID=smartbank-platform
SMARTBANK_ML_CONTRACT_VERSION=2026-08-01

# Database (MySQL/PostgreSQL connection string)
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/smartbankAI

# LLM (Conversational AI Agent)
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-3-5-sonnet-20241022

# ChromaDB (Vector store for RAG)
CHROMA_HOST=localhost
CHROMA_PORT=8000

# Model artefacts directory (local path or mounted volume)
MODEL_DIR=/app/models

# Logging
LOG_LEVEL=INFO   # DEBUG | INFO | WARNING | ERROR

# Prometheus metrics (optional)
ENABLE_METRICS=true
METRICS_PORT=9090
